# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
APP_URL=

# --- Pueblo live map -------------------------------------------------------
# Address of the God's Eye View map engine (its own Railway service), e.g.
# https://gev-production.up.railway.app. Read at build time. Without it the
# Interactive Map tab falls back to the simple built-in map.
VITE_GEV_URL=

# Optional: CDOT COtrip key (free from CDOT) for road incidents and
# construction. Without it those two layers show "needs a key".
COTRIP_API_KEY=

# Optional: override the Pueblo Transit GTFS schedule URL.
# PUEBLO_GTFS_URL=https://data.trilliumtransit.com/gtfs/pueblo-co-us/pueblo-co-us--flex-v2.zip

# Railway sets PORT itself; locally the server uses 3000.
# PORT=3000
